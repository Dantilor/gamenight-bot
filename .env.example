BOT_TOKEN=your_bot_token_here
# Frontend Mini App (web_app buttons). Never use the backend/API host here.
MINI_APP_URL=https://gamenight-web.onrender.com
# Legacy alias — used only if MINI_APP_URL is unset
# WEBAPP_URL=https://gamenight-web.onrender.com
# Backend API (HTTP requests only — never put this in web_app.url)
# API_URL=https://gamenight-web-api.onrender.com
# Webhook: на Render подставляется RENDER_EXTERNAL_URL; иначе задайте PUBLIC_URL
PUBLIC_URL=https://telegram-card-game.onrender.com
# Путь webhook (должен совпадать с URL в getWebhookInfo)
BOT_WEBHOOK_PATH=/telegram/webhook-9f3k2lQp
# Опционально: путь к SQLite БД подписок (по умолчанию: server/data/bot.db)
# DATABASE_PATH=./server/data/bot.db
