BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://your-mini-app-url-here
# Webhook: Render sets RENDER_EXTERNAL_URL; otherwise set PUBLIC_URL (e.g. https://your-app.onrender.com)
PUBLIC_URL=
# Секретный путь для webhook (не публикуйте). Пример: /telegram/webhook-abc123
BOT_WEBHOOK_PATH=/telegram/webhook-SECRET
