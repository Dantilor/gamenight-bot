# Telegram bot token from @BotFather. Never commit the real value.
BOT_TOKEN=123456789:replace-with-botfather-token

# Mini App origin. WebApp buttons open this host. Do not put the API host here.
MINI_APP_URL=https://dantilor-telegram-card-game-a2cc.twc1.net

# Public HTTPS origin of this bot service on Timeweb. Used only when webhook registration is enabled.
# Leave registration disabled until the manual cutover from the current host.
PUBLIC_URL=https://your-gamenight-bot.twc1.net

# Path Telegram will call. Use a long unguessable path. No trailing slash.
BOT_WEBHOOK_PATH=/telegram/webhook-replace-with-random-path

# 1-256 chars: A-Z, a-z, 0-9, underscore, hyphen.
# Telegram sends it in X-Telegram-Bot-Api-Secret-Token. Required before production cutover.
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-secret

# Main GameNight PostgreSQL. Use a dedicated role that can read plans and subscriptions
# and can write only the bot notice tables. Keep TLS verification enabled.
# Do not use sslmode=disable, sslmode=no-verify, or NODE_TLS_REJECT_UNAUTHORIZED=0.
DATABASE_URL=postgresql://gamenight_bot:replace-with-password@your-db-host:5432/gnh_supabase

# Optional TLS settings. Certificate checks stay enabled in every mode.
# DATABASE_TLS_CA_FILE is a PEM file. DATABASE_TLS_CA_PEM is the same public CA for an env field.
# For an IP host, DATABASE_TLS_SERVERNAME is required and must be the certificate name.
# DATABASE_TLS_CA_FILE=/path/to/timeweb-ca.pem
# DATABASE_TLS_CA_PEM=
# DATABASE_TLS_SERVERNAME=your-db-host
# GNH_EXPECT_HOST=your-db-host
# GNH_EXPECT_DATABASE=gnh_supabase
# GNH_EXPECT_USER=gamenight_bot

# Main game API. The bot reads GET /api/plans and does not create payments.
API_URL=https://dantilor-telegram-card-game-3706.twc1.net

# Keep false until the Timeweb service is checked and you are ready to move the live webhook.
# false: the process serves /health and does not call Telegram setWebhook.
# Shutdown never removes the webhook that is already registered.
ENABLE_WEBHOOK_REGISTRATION=false

# Keep false during the test deploy. false sends no subscription messages.
# The first enabled run records expirations that already happened and does not message them.
ENABLE_SUBSCRIPTION_NOTIFICATIONS=false

# Protects GET /health/db. Without it, that route answers 404.
# HEALTHCHECK_TOKEN=replace-with-random-string

# Timeweb sets PORT. Local default is 3000.
# PORT=3000
