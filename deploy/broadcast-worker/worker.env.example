# Copy to deploy/broadcast-worker/worker.env on the worker VPS (chmod 600). Never commit worker.env.
# The worker needs only these values. It does not serve webhooks and does not call setWebhook.

# Same bot token as the bot service (@GameNightHostBot).
BOT_TOKEN=123456789:replace-with-botfather-token

# Mini App origin for the "Играть в Mini App" button.
MINI_APP_URL=https://dantilor-telegram-card-game-a2cc.twc1.net

# Dedicated least-privilege role from grants.sql, not the owner role.
# Keep TLS verification on: no sslmode=disable / no-verify, no NODE_TLS_REJECT_UNAUTHORIZED=0.
DATABASE_URL=postgresql://gamenight_broadcast_worker:replace-with-password@your-db-host:5432/gnh_supabase
# CA of the managed database, mounted read-only from deploy/broadcast-worker/certs.
DATABASE_TLS_CA_FILE=/certs/db-ca.pem
# Required when the host in DATABASE_URL is an IP: the name in the server certificate.
# DATABASE_TLS_SERVERNAME=your-db-host
# Optional guards: refuse to start against a different database.
# GNH_EXPECT_HOST=your-db-host
# GNH_EXPECT_DATABASE=gnh_supabase
# GNH_EXPECT_USER=gamenight_broadcast_worker

# false (default): only "Тест себе" campaigns are sent. Confirmed mass campaigns wait in the queue.
# Set exactly "true" only after the owner approved the first test, then restart the container.
# Even then a mass campaign starts only if a test with the same text, photo and buttons was delivered.
BROADCAST_MASS_ENABLED=false

# Queue poll interval, seconds (1-300).
BROADCAST_POLL_SECONDS=5
# Queued campaigns older than this are not started automatically (0 = no limit). Running ones always resume.
BROADCAST_MAX_QUEUED_AGE_HOURS=24
# Pause between messages, ms (50-10000). 60 ms is about 16 messages per second.
BROADCAST_MIN_INTERVAL_MS=60
# Messages per cycle before the daemon re-checks schema and the mass switch.
BROADCAST_BATCH_SIZE=500
