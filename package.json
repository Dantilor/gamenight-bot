{
  "name": "gamenight-bot",
  "version": "1.0.0",
  "description": "Telegram bot launcher for GameNight Host",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx server/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "tsx server/src/migrate.ts",
    "test": "npm run build && tsx --test server/test/config.test.ts server/test/dbTls.test.ts server/test/webhook.test.ts server/test/commands.test.ts server/test/subscription.test.ts server/test/productionStart.test.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "telegraf",
    "mini-app"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
